# EditorConfig: https://editorconfig.org
root = true

# One tab per indentation level, displayed two columns wide.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2
tab_width = 2

# YAML forbids tabs for indentation.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown nests lists and code blocks with spaces, and two trailing spaces
# are a hard line break.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Make recipes must start with a real tab.
[Makefile]
indent_style = tab
